rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth.uid == "Ie35osxKxPMkroz5M6jvAe2Suhf2";
    }

    function isValidMessage() {
      return resource.data.keys().hasAll(['senderId', 'receiverId', 'timestamp']);
    }

    match /messages/{messageId} {
      allow read: if
        request.auth != null && (
          // User is sender/receiver
          request.auth.uid == resource.data.senderId ||
          request.auth.uid == resource.data.receiverId ||
          // Broadcast from admin
          (resource.data.receiverId == 'broadcast' && isAdmin())
        );

      allow create: if
        ( // User messages to admin
          (request.auth.uid == request.resource.data.senderId &&
          request.resource.data.receiverId == "Ie35osxKxPMkroz5M6jvAe2Suhf2") ||
          // Admin messages to any
          (isAdmin() && request.resource.data.receiverId is string)
        ) &&
        request.resource.data.timestamp == request.time;
    }

    function isValidInquiry() {
      let data = request.resource.data;
      return data.keys().hasOnly(['name', 'email', 'brand', 'link', 'platforms', 'timing', 'message', 'createdAt'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && data.email is string
        && data.email.matches('.+@.+\\..+')
        && data.email.size() <= 120
        && data.brand is string
        && data.brand.size() > 0
        && data.brand.size() <= 80
        && data.link is string
        && data.link.size() <= 200
        && data.timing is string
        && data.timing.size() <= 120
        && data.message is string
        && data.message.size() > 0
        && data.message.size() <= 2000
        && data.platforms is list
        && data.platforms.size() > 0
        && data.platforms.size() <= 5
        && data.platforms.hasOnly(['YouTube integration', 'YouTube Short', 'Instagram Reel', 'Short + Reel package', 'Not sure yet'])
        && data.createdAt == request.time;
    }

    match /inquiries/{inquiryId} {
      allow create: if isValidInquiry();
      allow read: if isAdmin();
    }
  }
}